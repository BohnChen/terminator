[global_config]
  window_state = maximize
  suppress_multiple_term_dialog = True
  focus = system
  title_transmit_bg_color = "#2e9c2e"

[keybindings]
  split_horiz = <Ctrl><Shift>O
  split_vert = <Ctrl><Shift>E
  next_tab = <Ctrl><Shift>N
  prev_tab = <Ctrl><Shift>P
  close_term = <Ctrl><Shift>W
  new_tab = <Ctrl><Shift>T

[profiles]
  [[default]]
    # 基础配色 — 深色背景 + 柔和文字
    background_color = "#282a36"
    foreground_color = "#f8f8f2"
    cursor_color = "#f8f8f2"
    # 选中文字背景色（亮黄）
    highlight_color = "#f1fa8c"
    # 选中文字前景色（深色）
    highlight_foreground_color = "#282a36"
    
    # 字体设置（清晰优先）
    font = JetBrains Mono 19
	line_height = 1.3   # 行高倍率，默认为 1.0，建议从 1.25-1.4 之间尝试
    use_system_font = False
    # 使用更清晰的抗锯齿
    antialias = True
    
    # 透明度（完全实心，显示最清晰）
    background_transparency = 1.0
    
    # 滚动
	scrollback_lines = 5000
    scroll_on_output = False
    scroll_on_keystroke = True
    
    # 光标形状
    cursor_shape = block
    cursor_blink = True
    
    # 颜色方案 — 基于 Dracula 主题优化
    # 黑
    color0 = "#21222c"
    color8 = "#6272a4"
    # 红
    color1 = "#ff5555"
    color9 = "#ff6e6e"
    # 绿
    color2 = "#50fa7b"
    color10 = "#69ff94"
    # 黄
    color3 = "#f1fa8c"
    color11 = "#ffffa5"
    # 蓝
    color4 = "#8be9fd"
    color12 = "#a4ffff"
    # 紫
    color5 = "#bd93f9"
    color13 = "#d6acff"
    # 青
    color6 = "#8be9fd"
    color14 = "#a4ffff"
    # 白
    color7 = "#f8f8f2"
    color15 = "#ffffff"
    
    # 使用配色方案
    use_colors = True
    
    # 显示终端边框（更好地分割窗格）
    show_border = True
    border_color = "#44475a"

[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
      size = 1200, 800
    [[[child0]]]
      type = Terminal
	  parent = window0
	  profile = default
